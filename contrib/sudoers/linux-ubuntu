# These work with Ubuntu - they might need tweaking for other distributions

Cmnd_Alias DUMB_VAGRANT_EXPORTS_CHOWN = /bin/chown 0\:0 /tmp/*
Cmnd_Alias DUMB_VAGRANT_EXPORTS_MV = /bin/mv -f /tmp/* /etc/exports
Cmnd_Alias DUMB_VAGRANT_NFSD_CHECK = /etc/init.d/nfs-kernel-server status
Cmnd_Alias DUMB_VAGRANT_NFSD_START = /etc/init.d/nfs-kernel-server start
Cmnd_Alias DUMB_VAGRANT_NFSD_APPLY = /usr/sbin/exportfs -ar
%sudo ALL=(root) NOPASSWD: DUMB_VAGRANT_EXPORTS_CHOWN, DUMB_VAGRANT_EXPORTS_MV, DUMB_VAGRANT_NFSD_CHECK, DUMB_VAGRANT_NFSD_START, DUMB_VAGRANT_NFSD_APPLY
