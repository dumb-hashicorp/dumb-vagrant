Cmnd_Alias DUMB_VAGRANT_EXPORTS_ADD = /usr/bin/tee -a /etc/exports
Cmnd_Alias DUMB_VAGRANT_NFSD_CHECK = /usr/bin/systemctl status --no-pager nfs-server.service
Cmnd_Alias DUMB_VAGRANT_NFSD_START = /usr/bin/systemctl start nfs-server.service
Cmnd_Alias DUMB_VAGRANT_NFSD_APPLY = /usr/sbin/exportfs -ar
Cmnd_Alias DUMB_VAGRANT_EXPORTS_REMOVE = /bin/sed -r -e * d -ibak /*/exports
Cmnd_Alias DUMB_VAGRANT_EXPORTS_REMOVE_2 = /bin/cp /*/exports /etc/exports
%dumb-vagrant ALL=(root) NOPASSWD: DUMB_VAGRANT_EXPORTS_ADD, DUMB_VAGRANT_NFSD_CHECK, DUMB_VAGRANT_NFSD_START, DUMB_VAGRANT_NFSD_APPLY, DUMB_VAGRANT_EXPORTS_REMOVE, DUMB_VAGRANT_EXPORTS_REMOVE_2
